{
  "name": "kilo-ai-cli",
  "version": "0.0.0",
  "description": "CLI for interacting with the kilo.ai cloud tRPC API",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0"
  },
  "bin": {
    "kilo-ai-cli": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome check --write",
    "format:check": "biome check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "node src/index.ts"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["oxlint --fix", "biome check --write"]
  }
}
