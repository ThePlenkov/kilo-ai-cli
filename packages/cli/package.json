{
  "name": "kilo-ai-cli",
  "version": "0.0.0",
  "description": "CLI for interacting with the kilo.ai cloud tRPC API",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0"
  },
  "bin": {
    "kilo-ai-cli": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome check --write",
    "format:check": "biome check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "node src/index.ts"
  },
  "dependencies": {
    "chalk": "^5.4.0",
    "citty": "^0.1.6",
    "ink": "^5.2.1",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "biome check --write"
    ]
  }
}
