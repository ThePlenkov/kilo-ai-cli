{
  "name": "kilo-ai-cli",
  "version": "0.4.2",
  "description": "CLI for interacting with the kilo.ai cloud tRPC API — auth, sessions, organizations, plans, KiloClaw, security agent, analytics, and more",
  "type": "module",
  "license": "MIT",
  "author": "ThePlenkov",
  "homepage": "https://github.com/ThePlenkov/kilo-ai-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThePlenkov/kilo-ai-cli.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ThePlenkov/kilo-ai-cli/issues"
  },
  "keywords": [
    "kilo",
    "kilo-ai",
    "kiloai",
    "cli",
    "trpc",
    "cloud",
    "security",
    "devops",
    "automation",
    "terminal"
  ],
  "engines": {
    "node": ">=24.21.0"
  },
  "bin": {
    "kilo-ai-cli": "dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome check --write",
    "format:check": "biome check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "node scripts/live-smoke.ts",
    "dev": "node src/index.ts",
    "prepublishOnly": "tsdown"
  },
  "dependencies": {
    "chalk": "^5.4.0",
    "citty": "^0.1.6",
    "ink": "^5.2.1",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "biome check --write"
    ]
  }
}
