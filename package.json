{
  "name": "kilo-ai-cli-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "nx build kilo-ai-cli",
    "test": "nx test kilo-ai-cli",
    "lint": "nx lint kilo-ai-cli",
    "format": "nx run kilo-ai-cli:format",
    "format:check": "nx run kilo-ai-cli:format-check",
    "typecheck": "nx typecheck kilo-ai-cli",
    "test:live": "npm run test:live -w kilo-ai-cli",
    "cli": "node packages/cli/dist/index.mjs",
    "dev": "node packages/cli/src/index.ts",
    "ci": "sh scripts/local-ci.sh run --entry ci/local",
    "ci:health": "sh scripts/local-ci.sh run --entry repo-health/check",
    "prepare": "husky",
    "ci:policy": "sh scripts/local-ci.sh policy",
    "ci:findings": "node packages/cli/scripts/findings.ts collect --out .sverka/findings.sarif",
    "ci:baseline": "node packages/cli/scripts/findings.ts baseline",
    "ci:backlog": "node packages/cli/scripts/findings.ts backlog"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@nx-devkit/release": "0.0.21",
    "@nx-devkit/skill": "0.1.19",
    "@nx-devkit/typescript": "0.2.18",
    "@nx/devkit": "23.3.0",
    "@nx/js": "23.3.0",
    "@sverka/verification": "0.2.41",
    "@sverka/workflow": "0.2.34",
    "@types/node": "22.20.2",
    "@types/react": "^18.3.31",
    "husky": "^9.1.7",
    "memfs": "^4.50.0",
    "nx": "23.3.0",
    "oxlint": "1.82.0",
    "semver": "^7.8.5",
    "tsdown": "0.23.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^6.4.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0"
  },
  "overrides": {
    "smol-toml": "1.9.0",
    "axios": "1.20.0",
    "source-map-js": "1.2.2",
    "brace-expansion": "5.0.12",
    "undici": "7.29.1",
    "@nx/devkit": "23.3.0",
    "@nx-devkit/typescript": {
      "typescript": "$typescript",
      "vitest": "$vitest",
      "tsdown": "$tsdown",
      "@biomejs/biome": "$@biomejs/biome",
      "oxlint": "$oxlint"
    }
  }
}
