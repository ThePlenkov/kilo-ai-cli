{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "appsDir": "release",
    "libsDir": "packages"
  },
  "plugins": [
    "./node_modules/@nx-devkit/typescript/dist/plugin.mjs",
    "./node_modules/@nx-devkit/release/dist/plugin.mjs",
    "./node_modules/@nx-devkit/skill/dist/plugin.mjs"
  ],
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tsdown.config.*",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/package.json",
        "{workspaceRoot}/package-lock.json"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "test": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/test/**/*",
        "{projectRoot}/vitest.config.*",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/package.json",
        "{workspaceRoot}/package-lock.json"
      ]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/test/**/*",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/package.json",
        "{workspaceRoot}/package-lock.json"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/test/**/*",
        "{projectRoot}/.oxlintrc.*",
        "{projectRoot}/package.json",
        "{workspaceRoot}/package-lock.json"
      ]
    },
    "format-check": {
      "cache": true
    }
  },
  "analytics": false
}
